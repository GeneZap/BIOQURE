# .gitignore for genomic data project

# Large genomic dataset files - exclude all subdirectories with UUID names
[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/

# CSV files with gene expression data
*.csv

# TSV files with genomic data
*.tsv

# Binary data files
*.bin
*.dat

# Log files
*.log

# Temporary files
*~
*.tmp
*.temp

# Python cache
__pycache__/
*.pyc

# IDE specific files
.vscode/
.idea/
*.swp
*.swo

# Environment files (if any)
.env
.venv/
venv/

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Large intermediate files
*.mat
*.h5
*.hdf5

# Configuration files that might contain sensitive data
config.ini
secrets.json

# Backup files
*.bak
*.backup

# OS generated files
.DS_Store
Thumbs.db

# Exclude the main project files that should be tracked
!biomarker_selection_algorithm.py
!merge_matrix.py
!metadata_extraction.py
!prepare_quantum_data.py
!MANIFEST.txt